# SOVEREIGN — copy to .env and fill. NEVER commit .env with real values.
# Postgres main database (required for API + clinic).
DATABASE_URL=postgres://sovereign:CHANGE_ME@127.0.0.1:5432/sovereign
# API server port (default 3001).
API_PORT=3001
# Demo login for clinic mock/API (replace with real auth later).
DEMO_LOGIN=doctor
DEMO_PASSWORD=CHANGE_ME
# Demo clinic code for local demo data (not a secret).
DEMO_CLINIC_CODE=DEMO
# Demo login is disabled automatically when NODE_ENV=production.

# Frontend demo login (development only; Vite exposes VITE_* to the browser).
VITE_DEMO_LOGIN=doctor
VITE_DEMO_PASSWORD=CHANGE_ME
