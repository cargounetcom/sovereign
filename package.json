{
  "name": "sovereign",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:clinic": "npm run dev --workspace @sovereign/clinic",
    "dev:meet": "npm run dev --workspace @sovereign/meet",
